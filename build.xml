<project default="compile">
    <path id="3rd-party-classpath">
        <fileset dir="./dsg_src/lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="test-classpath">
        <pathelement path="deployClasses"/>
        <path refid="3rd-party-classpath"/>
    </path>

    <!-- Sync dsg_src/java → deploy before compiling (respects exclude_compile.txt). Run ./justCompile for the full sync+compile in one step. -->
    <target name="sync">
        <exec executable="./justCompile" failonerror="true"/>
    </target>

    <target name="compile">
        <mkdir dir="deployClasses"/>
        <javac srcdir="deploy" destdir="deployClasses" debug="true" debuglevel="lines,vars,source">
            <classpath refid="3rd-party-classpath"/>
            <compilerarg value="-Xlint:deprecation,unchecked"/>
        </javac>
        <!-- non-class resources that ship with the classes (sync_gameServer.sh only deploys deployClasses/org) -->
        <copy todir="deployClasses">
            <fileset dir="dsg_src/java">
                <include name="org/pente/gameServer/core/username_*.txt"/>
            </fileset>
        </copy>
    </target>

    <!-- Compile test sources directly from dsg_src/java (bypasses rsync/exclude_compile.txt). -->
    <target name="compile-tests" depends="compile">
        <javac srcdir="dsg_src/java" destdir="deployClasses" debug="true" debuglevel="lines,vars,source">
            <include name="**/test/**/*.java"/>
            <!-- Exclude pre-existing tests with unresolvable dependencies -->
            <exclude name="**/client/**"/>
            <exclude name="**/opengl/**"/>
            <exclude name="**/tourney/test/DoubleEliminationDriver.java"/>
            <exclude name="**/message/test/BackgroundMailerTest.java"/>
            <exclude name="**/message/test/FilterTest.java"/>
            <exclude name="**/turnBased/test/TBStorerTest.java"/>
            <classpath refid="test-classpath"/>
        </javac>
    </target>

    <!-- Run all Redis cache unit tests. Does not require a real Redis or DB. -->
    <target name="test" depends="compile-tests">
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.tourney.test.CacheTourneyStorerRedisTest"/>
