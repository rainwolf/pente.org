<project default="compile">
    <path id="3rd-party-classpath">
        <fileset dir="./dsg_src/lib">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="test-classpath">
        <pathelement path="deployClasses"/>
        <path refid="3rd-party-classpath"/>
    </path>

    <!-- Sync dsg_src/java → deploy before compiling (respects exclude_compile.txt). Run ./justCompile for the full sync+compile in one step. -->
    <target name="sync">
        <exec executable="./justCompile" failonerror="true"/>
    </target>

    <target name="compile">
        <mkdir dir="deployClasses"/>
        <javac srcdir="deploy" destdir="deployClasses" debug="true" debuglevel="lines,vars,source">
            <classpath refid="3rd-party-classpath"/>
            <compilerarg value="-Xlint:deprecation,unchecked"/>
        </javac>
    </target>

    <!-- Compile test sources directly from dsg_src/java (bypasses rsync/exclude_compile.txt). -->
    <target name="compile-tests" depends="compile">
        <javac srcdir="dsg_src/java" destdir="deployClasses" debug="true" debuglevel="lines,vars,source">
            <include name="**/test/**/*.java"/>
            <!-- Exclude pre-existing tests with unresolvable dependencies -->
            <exclude name="**/client/**"/>
            <exclude name="**/opengl/**"/>
            <exclude name="**/tourney/test/DoubleEliminationDriver.java"/>
            <exclude name="**/message/test/**"/>
            <exclude name="**/turnBased/test/TBStorerTest.java"/>
            <classpath refid="test-classpath"/>
        </javac>
    </target>

    <!-- Run all Redis cache unit tests. Does not require a real Redis or DB. -->
    <target name="test" depends="compile-tests">
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.RedisConnectionManagerTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.core.test.CacheDSGFollowerStorerTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.core.test.CacheDSGPlayerStorerTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.tourney.test.CacheTourneyStorerTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.tourney.test.CacheTourneyStorerRedisTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.tourney.test.TourneySerializationTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.turnBased.test.CacheTBStorerRedisTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.core.test.SerialEventPumpTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.MMAIProtocolTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.MMAIPlayerInitTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <jvmarg value="--add-opens=java.base/java.lang=ALL-UNNAMED"/>
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.ArenaJoinRequestWireTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.ArenaJoinRequestRegistryTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.ArenaServerTableJoinRequestTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.ServerSocketEarlyFrameTest"/>
        </java>
    </target>

    <!-- Run a single test class: ant test-one -Dtest=org.pente.gameServer.server.test.RedisConnectionManagerTest -->
    <target name="test-one" depends="compile-tests">
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <jvmarg value="--add-opens=java.base/java.lang=ALL-UNNAMED"/>
            <classpath refid="test-classpath"/>
            <arg value="${test}"/>
        </java>
    </target>

    <!-- MMAI sidecar integration tests (spec 8.2). Requires the local binary:
         run ./dsg_src/mmai/build.sh first. Deliberately not part of 'test'. -->
    <target name="test-mmai-integration" depends="compile-tests">
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.gameServer.server.test.MMAIPlayerIntegrationTest"/>
        </java>
    </target>

    <!-- Google Play Billing unit tests (docs/superpowers/specs/2026-10-11-android-play-billing-design.md section 5).
         No DB, no network. 'compile' builds deploy/ (rsync dsg_src/java/ to deploy/ first, as ./justCompile does);
         this target then compiles org/pente/subscriptions/play/** including test/ straight from dsg_src/java. -->
    <target name="test-play-billing" depends="compile">
        <javac srcdir="dsg_src/java" destdir="deployClasses" sourcepath="" includeantruntime="false"
               debug="true" debuglevel="lines,vars,source">
            <include name="org/pente/subscriptions/play/**/*.java"/>
            <include name="org/pente/gameServer/tourney/VacationPurchaseRule.java"/>
            <classpath refid="test-classpath"/>
        </javac>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.AccountIdsTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayProductsTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayFakesTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlaySubscriptionSyncTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayProductSyncTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayRevokeTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.StoreInfoTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayPollerTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.RtdnTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.GooglePlayApiMappingTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.PlayWiringTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.VacationPurchaseRuleTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.GooglePlayPurchaseServletTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.TBVacationGrantTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.play.test.EntitlementExtractionTest"/>
        </java>
        <!-- play-billing test classes: add one <java> block per class above this line -->
    </target>

    <!-- MySQLPlayStore against a THROWAWAY MariaDB (it drops dsg_subscribers and dsg_subscribers_android).
         ant test-play-billing-db -DplayDbUrl=jdbc:mariadb://127.0.0.1:33099/playit?user=root -->
    <target name="test-play-billing-db" depends="test-play-billing">
        <fail unless="playDbUrl" message="set -DplayDbUrl to a throwaway MariaDB"/>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <sysproperty key="playDbUrl" value="${playDbUrl}"/>
            <sysproperty key="playMigration" value="${basedir}/dsg_src/sql/2026-10-11-google-play-billing.sql"/>
            <arg value="org.pente.subscriptions.play.test.MySQLPlayStoreIT"/>
        </java>
    </target>

    <!-- App Store Server API and Notifications V2 unit tests (docs/superpowers/specs/2026-10-15-ios-app-store-server-design.md
         section 5). No DB, no network. 'compile' builds deploy/ (rsync dsg_src/java/ to deploy/ first, as ./justCompile
         does); this target then compiles org/pente/subscriptions/apple/** including test/, plus the two shared Play
         fakes, straight from dsg_src/java. -->
    <target name="test-apple-billing" depends="compile">
        <javac srcdir="dsg_src/java" destdir="deployClasses" sourcepath="" includeantruntime="false"
               debug="true" debuglevel="lines,vars,source">
            <include name="org/pente/subscriptions/apple/**/*.java"/>
            <include name="org/pente/subscriptions/play/test/FakeSubscriberStore.java"/>
            <include name="org/pente/subscriptions/play/test/FakePlayerGateway.java"/>
            <classpath refid="test-classpath"/>
        </javac>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.apple.test.AppleRootCertificatesTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.apple.test.AppleAccountTokensTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.apple.test.AppleProductsTest"/>
        </java>
        <java classname="junit.textui.TestRunner" fork="true" failonerror="true">
            <classpath refid="test-classpath"/>
            <arg value="org.pente.subscriptions.apple.test.AppleSandboxAccountsTest"/>
        </java>
        <!-- apple-billing test classes: add one <java> block per class above this line -->
    </target>
</project>
