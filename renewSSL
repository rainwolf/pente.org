#!/bin/bash

open ~/mariposa/coding/keysCertificatesStuff.dmg 

cd letsencrypt
./getssl -f -w . pente.org || { echo "getssl failed, not restarting pente.org" >&2; exit 1; }

# Tomcat only reads MyDSKeyStore.jks at startup, so restart to load the new cert
ssh debian@pente.org docker compose -f docker-compose.yml restart pente.org
