scp keystore.p12 debian@pente.org:~/dockerMain/ssl/keystore.p12.tmp && ssh debian@pente.org 'chmod 600 ~/dockerMain/ssl/keystore.p12.tmp && mv ~/dockerMain/ssl/keystore.p12.tmp ~/dockerMain/ssl/keystore.p12' || { echo "ERROR: keystore push failed, live keystore untouched" >&2; exit 1; }
