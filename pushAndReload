#!/usr/bin/env bash

open ~/mariposa/coding/keysCertificatesStuff.dmg

export P=$(dirname "$0")
[ ! -f $P/.env ] || export $(grep -v '^#' $P/.env | xargs)

cd letsencrypt
cd pente.org

openssl pkcs12 -export -in fullchain.crt -inkey pente.org.key -name tomcat -passout env:SSL_PWD -out keystore.p12 || exit 1
